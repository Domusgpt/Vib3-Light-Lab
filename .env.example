# VIB3 Light Lab - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# FLUTTER ENVIRONMENT
# ============================================

# Flutter SDK Path (auto-detected, override if needed)
# FLUTTER_SDK_PATH=/path/to/flutter

# Build Environment (development, staging, production)
BUILD_ENV=development

# Enable Flutter DevTools
FLUTTER_DEVTOOLS_ENABLED=true

# ============================================
# WEBGL SERVER
# ============================================

# Local WebGL server for development
WEBGL_SERVER_URL=http://localhost:8151
WEBGL_SERVER_PORT=8151

# ============================================
# AGENT API
# ============================================

# Enable agent API for external control
AGENT_API_ENABLED=true
AGENT_API_PORT=8080
AGENT_API_HOST=localhost

# Agent API authentication
AGENT_API_KEY=dev_key_replace_in_production

# WebSocket server for real-time agent communication
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=8081

# ============================================
# AUDIO REACTIVITY
# ============================================

# FFT configuration
FFT_SIZE=4096
FFT_SMOOTHING=0.8

# Audio input device (auto-detect or specify)
AUDIO_INPUT_DEVICE=default

# Beat detection thresholds
BEAT_KICK_THRESHOLD=0.6
BEAT_SNARE_THRESHOLD=0.5
BEAT_HIHAT_THRESHOLD=0.4

# ============================================
# MIDI/OSC INTEGRATION
# ============================================

# MIDI configuration
MIDI_ENABLED=true
MIDI_LEARN_MODE=false

# OSC configuration
OSC_ENABLED=true
OSC_LISTEN_PORT=7000
OSC_SEND_PORT=7001
OSC_HOST=localhost

# ============================================
# VIDEO OUTPUT
# ============================================

# Syphon (macOS)
SYPHON_ENABLED=false
SYPHON_SERVER_NAME=VIB3_Light_Lab

# Spout (Windows)
SPOUT_ENABLED=false
SPOUT_SERVER_NAME=VIB3_Light_Lab

# NDI (Network)
NDI_ENABLED=false
NDI_SOURCE_NAME=VIB3_Light_Lab
NDI_DISCOVERY_SERVER=

# ============================================
# FIREBASE (CLOUD FEATURES)
# ============================================

# Firebase project configuration
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# Firebase Firestore (preset cloud storage)
FIRESTORE_ENABLED=false
FIRESTORE_COLLECTION=vib3_presets

# Firebase Authentication (optional for cloud features)
FIREBASE_AUTH_ENABLED=false

# ============================================
# TELEMETRY
# ============================================

# Enable telemetry collection (opt-in)
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=
TELEMETRY_FLUSH_INTERVAL_MS=5000

# Performance monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_LOG_INTERVAL_MS=1000

# ============================================
# DEVELOPMENT & DEBUGGING
# ============================================

# Debug logging level (error, warning, info, debug, trace)
LOG_LEVEL=debug

# Enable debug overlay in Flutter
DEBUG_OVERLAY_ENABLED=true

# Enable performance profiling
PROFILING_ENABLED=true

# Hot reload enabled (automatically true in development)
HOT_RELOAD_ENABLED=true

# ============================================
# PERFORMANCE TARGETS
# ============================================

# Parameter update latency target (milliseconds)
PARAM_UPDATE_TARGET_MS=16

# System switch time target (milliseconds)
SYSTEM_SWITCH_TARGET_MS=300

# Target frame rate
TARGET_FPS=60

# ============================================
# UI CONFIGURATION
# ============================================

# Touch target minimum size (pixels, WCAG AAA = 60)
TOUCH_TARGET_MIN_SIZE=60

# Haptic feedback enabled
HAPTIC_FEEDBACK_ENABLED=true

# Glassmorphic effects enabled (may impact performance)
GLASSMORPHIC_UI_ENABLED=true

# ============================================
# PRESET & GALLERY
# ============================================

# Local preset storage path
PRESET_STORAGE_PATH=./presets

# Gallery thumbnail size
GALLERY_THUMBNAIL_WIDTH=256
GALLERY_THUMBNAIL_HEIGHT=256

# Maximum presets in gallery
MAX_GALLERY_PRESETS=100

# Auto-save interval (milliseconds, 0 = disabled)
AUTO_SAVE_INTERVAL_MS=0

# ============================================
# SECURITY
# ============================================

# API rate limiting (requests per second)
RATE_LIMIT_REQUESTS_PER_SECOND=60

# Maximum WebSocket connections
MAX_WEBSOCKET_CONNECTIONS=10

# Enable CORS (for web builds)
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*

# ============================================
# EXPERIMENTAL FEATURES
# ============================================

# AI-generated presets
AI_PRESETS_ENABLED=false
AI_MODEL_ENDPOINT=

# Multi-device sync
MULTI_DEVICE_SYNC_ENABLED=false

# Gesture recording
GESTURE_RECORDING_ENABLED=false

# Show planner/sequencer
SHOW_PLANNER_ENABLED=false

# ============================================
# PLATFORM-SPECIFIC
# ============================================

# Windows
WINDOWS_DPI_AWARENESS=true

# macOS
MACOS_METAL_ENABLED=true

# Linux
LINUX_WAYLAND_ENABLED=true

