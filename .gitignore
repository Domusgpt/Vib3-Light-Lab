# ============================================
# VIB3 LIGHT LAB SPECIFIC
# ============================================

# Local preset storage
/presets/local/
*.preset.local

# Gallery exports
/gallery/exports/temp/

# Performance profiling data
/debug-info/
*.timeline
*.trace

# WebGL build artifacts
/webgl/build/
/webgl/dist/

# Audio recordings (if capturing for testing)
/audio/recordings/

# Video output captures
/video/captures/

# Agent telemetry data (keep example files)
/telemetry/data/
!telemetry/data/.gitkeep

# ============================================
# DOCUMENTATION ARTIFACTS
# ============================================
*.pdf
*.docx
/docs/generated/

# ============================================
# TESTING
# ============================================
test_coverage/
.test_coverage/
integration_test/screenshots/
integration_test/recordings/

# ============================================
